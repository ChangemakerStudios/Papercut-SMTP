{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },

  "SmtpServer": {
    "IP": "Any",
    "Port": 2525,
    "MessagePath": "%BaseDirectory%\\Incoming",
    "LoggingPath": "%DataDirectory%\\Logs;%BaseDirectory%\\Logs",
    "AllowedIps": "*",
    "RateLimit": "*",
    "RateLimitReplyCode": 451
  },

  "Urls": "http://0.0.0.0:8080",

  "HttpPathPrefix": "",

  "EnableMcpServer": false,

  "AllowedHosts": "*"
}